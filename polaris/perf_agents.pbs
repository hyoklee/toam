#!/bin/bash
#PBS -N toam-agents
#PBS -l select=1:system=polaris
#PBS -l walltime=01:00:00
#PBS -l filesystems=home:eagle
#PBS -q debug
#PBS -A radix-io
#PBS -j oe
#PBS -o /eagle/radix-io/hyoklee/toam/toam_agents.log
# Has three agents run the toam workflow on a Polaris compute node, NRUNS
# headless runs each, with the same task as vista/perf_agent.slurm:
#   claude   Claude Code, Claude Opus 5.5 (Anthropic API through the ALCF proxy).
#            Tools limited to Read/Glob/Grep and the two workflow commands.
#   alcf     clio agent (clio-coder), ALCF Sophia openai/gpt-oss-120b.
#   nemotron clio agent (clio-coder), Nemotron 3 Nano 30B-A3B (Q4_K_M) served
#            by Ollama on this node's A100, model staged to local SSD.
# Each run starts in a fresh copy of scripts/. A `python` shim on PATH times
# every Python call the agent makes. Before the agents, the workflow runs
# alone 5 times (after one warm-up) as a baseline.
set -uo pipefail
NRUNS=${NRUNS:-5}
AGENTS=${AGENTS:-"claude alcf nemotron"}
REPO=/home/hyoklee/toam
PY=/eagle/radix-io/hyoklee/toam/venv/bin/python
CLAUDE=/home/hyoklee/miniconda3/bin/claude   # not on the batch PATH
OLLAMA_ROOT=/eagle/radix-io/hyoklee/ollama/v0.40.8
JOBID=${PBS_JOBID%%.*}
OUT=/eagle/radix-io/hyoklee/toam/agents_$JOBID
LOCAL=/local/scratch/ollama_models_$JOBID
mkdir -p $OUT
export MPLBACKEND=Agg
# Compute nodes reach the outside only through the ALCF proxy; Node (clio-coder)
# needs NODE_USE_ENV_PROXY to use it. Ollama is local.
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HTTP_PROXY=$http_proxy HTTPS_PROXY=$https_proxy NODE_USE_ENV_PROXY=1
export no_proxy=127.0.0.1,localhost NO_PROXY=127.0.0.1,localhost
export OLLAMA_HOST=127.0.0.1:11519 OLLAMA_CONTEXT_LENGTH=131072 OLLAMA_KEEP_ALIVE=-1 OLLAMA_FLASH_ATTENTION=1
echo "host=$(hostname) start=$(date -Is) toam=$(git -C $REPO log -1 --format=%h) claude=$($CLAUDE --version 2>&1 | head -1) clio-coder=$(clio-coder --version 2>&1 | head -1) python=$($PY -c 'import sys,numpy,pandas,matplotlib;print(sys.version.split()[0],numpy.__version__,pandas.__version__,matplotlib.__version__)')"

TASK='Run the TOAM verification workflow in this directory: first run `python scripts/generate_data.py`, then run `python scripts/analysis.py`. Do not edit any file under scripts/. When both finish, report the baseline, TO-AB and TO-VT endurance limits written in docs/results.md.'

# Start the Nemotron server now so its ~100 s of staging and start-up overlaps the other agents.
SRV=
if [[ " $AGENTS " == *" nemotron "* ]]; then
  ( mkdir -p $LOCAL && cp -r /eagle/radix-io/hyoklee/models/ollama/. $LOCAL/ \
    && OLLAMA_MODELS=$LOCAL exec $OLLAMA_ROOT/bin/ollama serve ) > $OUT/ollama_serve.log 2>&1 &
  SRV=$!
fi
trap '[ -n "$SRV" ] && pkill -P $SRV; kill $SRV 2>/dev/null; rm -rf $LOCAL' EXIT

# --- baseline: the workflow alone --------------------------------------------------
B=$OUT/baseline; mkdir -p $B && cp -r $REPO/scripts $B/
( cd $B && $PY scripts/generate_data.py > /dev/null && $PY scripts/analysis.py > /dev/null )   # warm-up
for i in 1 2 3 4 5; do
  t0=$(date +%s.%N); ( cd $B && $PY scripts/generate_data.py > /dev/null ); t1=$(date +%s.%N)
  ( cd $B && $PY scripts/analysis.py > /dev/null ); t2=$(date +%s.%N)
  echo "BASELINE iter$i generate_s=$(echo "$t1 - $t0" | bc) analysis_s=$(echo "$t2 - $t1" | bc) total_s=$(echo "$t2 - $t0" | bc)"
done

# make_shim <dir>: `python`/`python3` that time each call into <dir>/pycalls.txt
make_shim() {
  mkdir -p $1/bin
  cat > $1/bin/python <<SHIM
#!/bin/bash
s=\$(date +%s.%N)
$PY "\$@"
rc=\$?
echo "PYCALL \$(echo "\$(date +%s.%N) - \$s" | bc) rc=\$rc args=\$*" >> $1/pycalls.txt
exit \$rc
SHIM
  chmod +x $1/bin/python && ln -sf python $1/bin/python3
}

# agent_run <agent> <i>
agent_run() {
  local W=$OUT/$1_$2 rc=0
  mkdir -p $W/work && cp -r $REPO/scripts $W/work/
  make_shim $W
  local T0=$(date +%s.%N)
  case $1 in
    claude)
      # The prompt goes first: --allowedTools takes every argument after it.
      ( cd $W/work && PATH=$W/bin:$PATH timeout 600 $CLAUDE -p "$TASK" --model claude-opus-5-5 \
          --output-format stream-json --verbose \
          --allowedTools Read Glob Grep \
            "Bash(python scripts/generate_data.py)" "Bash(python scripts/analysis.py)" \
            "Bash(python3 scripts/generate_data.py)" "Bash(python3 scripts/analysis.py)" \
          ) > $W/agent.jsonl 2> $W/agent.stderr || rc=$? ;;
    alcf|nemotron)
      local target=alcf-sophia; [ $1 = nemotron ] && target=polaris-nemotron
      PATH=$W/bin:$PATH timeout 600 clio-coder run --cwd $W/work --target $target \
          --autonomy yolo --no-delegate --timeout 540 --json "$TASK" \
          > $W/agent.jsonl 2> $W/agent.stderr || rc=$? ;;
  esac
  local wall=$(echo "$(date +%s.%N) - $T0" | bc)
  local py=$(awk '{s+=$2} END {printf "%.2f", s}' $W/pycalls.txt 2>/dev/null || echo 0)
  local ncall=$( (cat $W/pycalls.txt 2>/dev/null || true) | wc -l)
  local ok=no
  grep -q "TO‑AB corrected ≈  178.5" $W/work/docs/results.md 2>/dev/null && \
    grep -q "TO‑VT corrected ≈  193.9" $W/work/docs/results.md && ok=yes
  local edited=$(diff -rq $REPO/scripts $W/work/scripts > /dev/null && echo no || echo yes)
  echo "AGENT $1 run$2 wall=${wall}s rc=$rc python_calls=$ncall python_s=$py results_ok=$ok scripts_edited=$edited"
}

for agent in $AGENTS; do
  if [ $agent = nemotron ]; then
    for _ in $(seq 300); do curl -sf http://$OLLAMA_HOST/api/version > /dev/null && break; sleep 1; done
    t0=$(date +%s.%N)
    curl -sf http://$OLLAMA_HOST/api/generate -d '{"model":"nemotron-3-nano:latest","prompt":"","keep_alive":-1}' > /dev/null \
      || { echo "nemotron: server or model load failed"; continue; }
    echo "nemotron: model loaded in $(echo "$(date +%s.%N) - $t0" | bc) s"
  fi
  for i in $(seq $NRUNS); do agent_run $agent $i; done
done
nvidia-smi --query-gpu=index,memory.used --format=csv,noheader | sed 's/^/GPU /'
echo "end=$(date -Is)"
